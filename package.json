{
  "name": "flowrag",
  "version": "1.9.4",
  "private": true,
  "description": "🏠 Monorepo root containing npm workspace configuration, shared build/test/lint scripts, and all development tooling (Biome, Vitest, Lefthook). Not published to npm.",
  "keywords": [
    "monorepo",
    "workspace",
    "tooling"
  ],
  "homepage": "https://github.com/Zweer/FlowRAG#readme",
  "bugs": {
    "url": "https://github.com/Zweer/FlowRAG/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zweer/FlowRAG.git"
  },
  "license": "MIT",
  "author": {
    "name": "Zweer",
    "email": "n.olivieriachille@gmail.com"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf --glob packages/**/dist",
    "predocs:build": "npm run scripts:llms",
    "docs:build": "astro build --root docs",
    "docs:dev": "astro dev --root docs",
    "docs:preview": "astro preview --root docs",
    "prelint": "npm run build",
    "lint": "concurrently npm:lint:* --prefixColors auto",
    "postlint": "npm run clean",
    "lint:engines": "ls-engines",
    "lint:format": "biome check --write",
    "lint:lockfile": "lockfile-lint",
    "lint:package": "npmPkgJsonLint .",
    "lint:sort_package": "sort-package-json \"package.json\" \"packages/*/package.json\"",
    "lint:typecheck": "tsc --noEmit && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/mcp",
    "prepare": "test -n \"$CI\" || lefthook install",
    "release": "bonvoy shipit",
    "scripts:dummy": "publish-dummy-package",
    "scripts:llms": "node scripts/generate-llms-txt.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "posttest": "npm run clean",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "npm run clean && coverage-badge-readme",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "posttest:e2e": "npm run clean"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "@huggingface/transformers": "4.3.2",
    "fast-xml-parser": ">=5.5.7"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@astrojs/starlight": "^0.42.11",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@zweer/coverage-badge-readme": "^1.4.0",
    "@zweer/publish-dummy-package": "^0.2.1",
    "astro": "7.4.1",
    "bonvoy": "^0.13.1",
    "concurrently": "^9.2.1",
    "cookie": "^2.0.2",
    "lefthook": "^2.2.2",
    "lockfile-lint": "^5.0.0",
    "ls-engines": "^0.10.1",
    "npm-package-json-lint": "^11.0.1",
    "npm-package-json-lint-config-default": "^10.0.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "sort-package-json": "^3.6.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">= 22.22"
  },
  "lockfile-lint": {
    "path": "package-lock.json",
    "type": "npm",
    "validate-https": true,
    "allowed-hosts": [
      "npm"
    ]
  }
}
